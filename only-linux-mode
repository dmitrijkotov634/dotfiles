#!/bin/bash
# grub-hide-windows.sh — Hide Windows from GRUB, set timeout to 0

set -e

GRUB_CFG="/etc/default/grub"

sudo sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=0/' "$GRUB_CFG"

if grep -q '^GRUB_DISABLE_OS_PROBER=' "$GRUB_CFG"; then
    sudo sed -i 's/^GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=true/' "$GRUB_CFG"
else
    echo 'GRUB_DISABLE_OS_PROBER=true' | sudo tee -a "$GRUB_CFG" > /dev/null
fi

if grep -q '^GRUB_TIMEOUT_STYLE=' "$GRUB_CFG"; then
    sudo sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' "$GRUB_CFG"
else
    echo 'GRUB_TIMEOUT_STYLE=hidden' | sudo tee -a "$GRUB_CFG" > /dev/null
fi

sudo grub-mkconfig -o /boot/grub/grub.cfg

echo "Done! Windows hidden, timeout set to 0."
