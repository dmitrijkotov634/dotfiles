#!/bin/bash
# grub-show-windows.sh — Restore Windows in GRUB menu

set -e

GRUB_CFG="/etc/default/grub"
TIMEOUT="${1:-5}"

sudo sed -i "s/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=$TIMEOUT/" "$GRUB_CFG"
sudo sed -i 's/^GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' "$GRUB_CFG"
sudo sed -i 's/^GRUB_TIMEOUT_STYLE=hidden/GRUB_TIMEOUT_STYLE=menu/' "$GRUB_CFG"

sudo grub-mkconfig -o /boot/grub/grub.cfg

echo "Done! Windows restored, timeout set to ${TIMEOUT}s."
